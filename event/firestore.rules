rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 공개 목록: 누구나 읽기 가능, 새 등록만 허용 (수정/삭제 불가)
    match /entries/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['nickname', 'url', 'description', 'createdAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 300
        && request.resource.data.url.matches('^https?://[^\\s]+$')
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // 연락처: 아무도 읽을 수 없음 (Firebase 콘솔에서 관리자만 확인)
    // 같은 ID의 entries 문서와 함께 등록될 때만 생성 가능
    match /contacts/{entryId} {
      allow create: if request.resource.data.keys().hasOnly(['contact', 'createdAt'])
        && request.resource.data.contact is string
        && request.resource.data.contact.size() > 0
        && request.resource.data.contact.size() <= 100
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/entries/$(entryId))
        && existsAfter(/databases/$(database)/documents/entries/$(entryId));
      allow read, update, delete: if false;
    }
  }
}
